        <mxCell id="mpf_write_to_fin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#475569;" edge="1" source="mp_act_nfc_write" target="mp_act_nfc_finish" parent="lane_ma_nfc"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="mpf_emit_ui" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#16A34A;" edge="1" source="mp_dec_has_cmd" target="mp_act_ui_stream" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="mpf_7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#475569;" edge="1" source="mp_act_ui_stream" target="mp_act_ui_cards" parent="lane_ma_ui"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mpf_8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#475569;" edge="1" source="mp_act_ui_cards" target="mp_node_end" parent="lane_ma_ui"><mxGeometry relative="1" as="geometry"/></mxCell>
    
