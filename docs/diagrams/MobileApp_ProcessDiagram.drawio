<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="app.diagrams.net" modified="2026-10-22T01:05:00.000Z" agent="Antigravity" version="24.0.0" type="device">
  <diagram id="mobile-app-process-diagram" name="Diagrama de Procesos - Flutter Mobile App">
    <mxGraphModel dx="2100" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1550" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Titulo -->
        <mxCell id="ma_proc_title" value="&lt;b&gt;&lt;font size=&quot;4&quot;&gt;HELiOSTRAND - DIAGRAMA DE ACTIVIDADES Y PROCESOS (FLUTTER MOBILE APP)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Proceso: VersionGate, Sesión Transaccional NFC (Lectura Ping-Pong y Escritura de Servos) y Renderizado Reactivo con Streams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#F8FAFC;align=center;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1680" height="58" as="geometry"/>
        </mxCell>

        <!-- Swimlanes -->
        <mxCell id="lane_ma_gate" value="&lt;b&gt;Servicios de Políticas &amp;amp; Gateways (UpdatePolicyService &amp;amp; VersionGate)&lt;/b&gt;" style="swimlane;startSize=40;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontStyle=1;fontSize=13;swimlaneLine=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="520" height="1360" as="geometry"/>
        </mxCell>

        <mxCell id="lane_ma_nfc" value="&lt;b&gt;Transporte &amp;amp; Dominio (BaseTelemetryService, NfcService &amp;amp; TheoJansenDataParser)&lt;/b&gt;" style="swimlane;startSize=40;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;fontSize=13;swimlaneLine=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="600" height="1360" as="geometry"/>
        </mxCell>

        <mxCell id="lane_ma_ui" value="&lt;b&gt;Capa UI Reactiva (DashboardScreen &amp;amp; Widgets de Tarjetas)&lt;/b&gt;" style="swimlane;startSize=40;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0369A1;fontStyle=1;fontSize=13;swimlaneLine=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1160" y="100" width="560" height="1360" as="geometry"/>
        </mxCell>

        <!-- Nodos de Inicio -->
        <mxCell id="mp_node_start" value="" style="ellipse;fillColor=#1E293B;strokeColor=#0F172A;" vertex="1" parent="lane_ma_gate">
          <mxGeometry x="240" y="60" width="40" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="mp_act_gate_check" value="&lt;b&gt;VersionGate.initState()&lt;/b&gt;&lt;br&gt;Consultar UpdatePolicyService.requiresUpdate(currentVersion)&lt;br&gt;Comprobar compatibilidad mínima con protocolo V2 (2.0.0)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#D97706;fontColor=#78350F;strokeWidth=2;" vertex="1" parent="lane_ma_gate">
          <mxGeometry x="90" y="130" width="340" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="mp_dec_update_req" value="¿Requiere&lt;br&gt;actualización?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontStyle=1;strokeWidth=2;" vertex="1" parent="lane_ma_gate">
          <mxGeometry x="180" y="230" width="160" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="mp_act_gate_lock" value="&lt;b&gt;Bloquear Interfaz Móvil&lt;/b&gt;&lt;br&gt;Renderizar pantalla de alerta obligatoria con enlace directo a tienda o APK corporativo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;strokeWidth=2;" vertex="1" parent="lane_ma_gate">
          <mxGeometry x="20" y="360" width="280" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="mp_node_gate_stop" value="" style="ellipse;shape=endState;fillColor=#1E293B;strokeColor=#0F172A;" vertex="1" parent="lane_ma_gate">
          <mxGeometry x="140" y="460" width="40" height="40" as="geometry"/>
        </mxCell>

        <!-- UI: Dashboard -->
        <mxCell id="mp_act_ui_dash" value="&lt;b&gt;Cargar DashboardScreen&lt;/b&gt;&lt;br&gt;Inicializar StreamSubscriptions de BaseTelemetryService y preparar tarjetas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#0284C7;fontColor=#0369A1;strokeWidth=2;" vertex="1" parent="lane_ma_ui">
          <mxGeometry x="120" y="245" width="320" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="mp_dec_mode" value="¿Modo Seleccionado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0369A1;fontStyle=1;strokeWidth=2;" vertex="1" parent="lane_ma_ui">
          <mxGeometry x="190" y="345" width="180" height="90" as="geometry"/>
        </mxCell>

        <!-- Simulación -->
        <mxCell id="mp_act_sim_stream" value="&lt;b&gt;SimulationService.start()&lt;/b&gt;&lt;br&gt;Emitir lecturas sintetizadas en Stream periódico cada 1000ms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;strokeWidth=2;" vertex="1" parent="lane_ma_ui">
          <mxGeometry x="280" y="470" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- NFC Session -->
        <mxCell id="mp_act_nfc_poll" value="&lt;b&gt;NfcService.readTelemetry()&lt;/b&gt;&lt;br&gt;Invocar &lt;code&gt;FlutterNfcKit.poll(timeout: 20s)&lt;/code&gt; solicitando ISO14443-A" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#14532D;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="140" y="470" width="320" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="mp_dec_tag_found" value="¿Tag NTAG213&lt;br&gt;Detectado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="220" y="565" width="160" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="mp_act_nfc_read_pages" value="&lt;b&gt;Lectura Transaccional de Memoria&lt;/b&gt;&lt;br&gt;Leer páginas 4 a 11 (Slot A: 4-7, Slot B: 8-11) mediante comandos FAST_READ o READ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#14532D;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="130" y="690" width="340" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="mp_act_nfc_parse" value="&lt;b&gt;TheoJansenDataParser.decodePayload()&lt;/b&gt;&lt;br&gt;1. Seleccionar generación más reciente (Ping-Pong)&lt;br&gt;2. Verificar CRC-8 (polinomio 0x07)&lt;br&gt;3. Deserializar LDRs, Ángulos, Batería y Motor" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#14532D;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="130" y="785" width="340" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="mp_dec_crc_valid" value="¿Trama y CRC-8&lt;br&gt;Válidos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="220" y="890" width="160" height="85" as="geometry"/>
        </mxCell>

        <!-- Command Write Phase (Móvil puede escribir!) -->
        <mxCell id="mp_dec_has_cmd" value="¿Existe comando&lt;br&gt;de servos pendiente?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0369A1;fontStyle=1;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="210" y="1005" width="180" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="mp_act_nfc_write" value="&lt;b&gt;FlutterNfcKit.transceive()&lt;/b&gt;&lt;br&gt;Escribir página de comando (Pitch/Yaw) en NTAG213 antes de desconectar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0369A1;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="130" y="1125" width="340" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="mp_act_nfc_finish" value="&lt;b&gt;FlutterNfcKit.finish()&lt;/b&gt;&lt;br&gt;Cerrar canal RF y liberar el transceptor NFC del smartphone" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#14532D;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="160" y="1220" width="280" height="50" as="geometry"/>
        </mxCell>

        <!-- UI: Reactividad & Renderizado -->
        <mxCell id="mp_act_ui_stream" value="&lt;b&gt;StreamController.add(RobotTelemetry)&lt;/b&gt;&lt;br&gt;Emitir modelo hacia el Stream reactivo de la UI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#0284C7;fontColor=#0369A1;strokeWidth=2;" vertex="1" parent="lane_ma_ui">
          <mxGeometry x="140" y="1020" width="280" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="mp_act_ui_cards" value="&lt;b&gt;Reconstrucción Reactiva de Tarjetas&lt;/b&gt;&lt;br&gt;• &lt;b&gt;LdrChartCard:&lt;/b&gt; Gráfico radar brújula de 4 cuadrantes&lt;br&gt;• &lt;b&gt;ServosCard:&lt;/b&gt; Ángulos actuales y controles interactivos&lt;br&gt;• &lt;b&gt;MotorBatteryCard:&lt;/b&gt; Indicador de voltaje y estado H-Bridge&lt;br&gt;• &lt;b&gt;HistoryCard:&lt;/b&gt; Anexar muestra para exportación JSON/CSV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#0284C7;fontColor=#0369A1;strokeWidth=2;align=left;spacingLeft=15;" vertex="1" parent="lane_ma_ui">
          <mxGeometry x="90" y="1115" width="380" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="mp_node_end" value="" style="ellipse;shape=endState;fillColor=#1E293B;strokeColor=#0F172A;" vertex="1" parent="lane_ma_ui">
          <mxGeometry x="260" y="1270" width="40" height="40" as="geometry"/>
        </mxCell>

        <!-- Flujos / Conexiones -->
        <mxCell id="mpf_1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#475569;" edge="1" source="mp_node_start" target="mp_act_gate_check" parent="lane_ma_gate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mpf_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#475569;" edge="1" source="mp_act_gate_check" target="mp_dec_update_req" parent="lane_ma_gate"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="mpf_up_yes" value="[Sí: Obsoleta]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#DC2626;labelBackgroundColor=#FFFFFF;fontColor=#B91C1C;" edge="1" source="mp_dec_update_req" target="mp_act_gate_lock" parent="lane_ma_gate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mpf_up_stop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#DC2626;" edge="1" source="mp_act_gate_lock" target="mp_node_gate_stop" parent="lane_ma_gate"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="mpf_up_no" value="[No: Versión Válida]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;fontColor=#15803D;" edge="1" source="mp_dec_update_req" target="mp_act_ui_dash" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="mpf_3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#475569;" edge="1" source="mp_act_ui_dash" target="mp_dec_mode" parent="lane_ma_ui"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="mpf_sim" value="[Simulación]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#64748B;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" source="mp_dec_mode" target="mp_act_sim_stream" parent="lane_ma_ui"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mpf_sim_to_stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#64748B;" edge="1" source="mp_act_sim_stream" target="mp_act_ui_stream" parent="lane_ma_ui"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="mpf_nfc" value="[NFC Real]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;fontColor=#15803D;" edge="1" source="mp_dec_mode" target="mp_act_nfc_poll" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="mpf_4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#475569;" edge="1" source="mp_act_nfc_poll" target="mp_dec_tag_found" parent="lane_ma_nfc"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="mpf_tag_no" value="[Timeout]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#D97706;labelBackgroundColor=#FFFFFF;fontColor=#B45309;" edge="1" source="mp_dec_tag_found" target="mp_act_nfc_poll" parent="lane_ma_nfc">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="610"/><mxPoint x="490" y="500"/></Array></mxGeometry>
        </mxCell>

        <mxCell id="mpf_tag_yes" value="[Tag Presente]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;fontColor=#15803D;" edge="1" source="mp_dec_tag_found" target="mp_act_nfc_read_pages" parent="lane_ma_nfc"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="mpf_5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#475569;" edge="1" source="mp_act_nfc_read_pages" target="mp_act_nfc_parse" parent="lane_ma_nfc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mpf_6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#475569;" edge="1" source="mp_act_nfc_parse" target="mp_dec_crc_valid" parent="lane_ma_nfc"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="mpf_mcrc_no" value="[Error CRC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#DC2626;labelBackgroundColor=#FFFFFF;fontColor=#B91C1C;" edge="1" source="mp_dec_crc_valid" target="mp_act_nfc_finish" parent="lane_ma_nfc">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="932"/><mxPoint x="90" y="1245"/></Array></mxGeometry>
        </mxCell>

        <mxCell id="mpf_mcrc_yes" value="[Válido]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;fontColor=#15803D;" edge="1" source="mp_dec_crc_valid" target="mp_dec_has_cmd" parent="lane_ma_nfc"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="mpf_cmd_yes" value="[Sí]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0284C7;labelBackgroundColor=#FFFFFF;fontColor=#0369A1;" edge="1" source="mp_dec_has_cmd" target="mp_act_nfc_write" parent="lane_ma_nfc"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="mpf_cmd_no" value="[No: Solo lectura]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#475569;labelBackgroundColor=#FFFFFF;fontColor=#334155;" edge="1" source="mp_dec_has_cmd" target="mp_act_nfc_finish" parent="lane_ma_nfc">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="1050"/><mxPoint x="120" y="1245"/></Array></mxGeometry>
