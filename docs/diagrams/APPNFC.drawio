  <diagram id="diag-nfc-classes" name="Diagrama Histórico (Android Kotlin Original)"><mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="&amp;lt;&amp;lt;ActivityManager&amp;gt;&amp;gt;&amp;#xa;&amp;lt;b&amp;gt;NfcPermissionManager&amp;lt;/b&amp;gt;&amp;#xa;--&amp;#xa;- Context: Context&amp;#xa;- nfcAdapter: NfcAdapter?&amp;#xa;--&amp;#xa;+ isNfcSupported(): Boolean&amp;#xa;+ isNfcEnable(): Boolean&amp;#xa;+ promptEnableNfc(activity: Activity): Unit&amp;#xa;+ hasNfcPermission(): Boolean" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=12;whiteSpace=wrap;html=1;rounded=0;shadow=0;glass=0;sketch=0;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="300" height="180" as="geometry" /></mxCell><mxCell id="c2" value="&amp;lt;&amp;lt;ForegroundDispatch&amp;gt;&amp;gt;&amp;#xa;&amp;lt;b&amp;gt;NfcReaderManager&amp;lt;/b&amp;gt;&amp;#xa;--&amp;#xa;- activity: Activity&amp;#xa;- pendingIntent: PendingIntent&amp;#xa;- intentFilters: Array&amp;lt;IntentFilter&amp;gt;&amp;#xa;+ onTagDiscoveredListener: ((tag) -&amp;gt; Unit)?&amp;#xa;--&amp;#xa;+ enableReaderMode(): Unit&amp;#xa;+ disableReaderMode(): Unit&amp;#xa;+ handleIntent(intent: Intent): Tag?" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=12;whiteSpace=wrap;html=1;rounded=0;shadow=0;glass=0;sketch=0;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="320" height="200" as="geometry" /></mxCell><mxCell id="c3" value="&amp;lt;&amp;lt;NdefParser/LowLevelDataParser&amp;gt;&amp;gt;&amp;#xa;&amp;lt;b&amp;gt;NfcDataParser&amp