        </mxCell>

        <!-- _DashboardScreenState has SimulationService -->
        <mxCell id="rel_dash_sim" value="- _simulationService" style="endArrow=diamondThin;endFill=1;endSize=14;html=1;rounded=0;exitX=1;exitY=0.8;entryX=0;entryY=0.4;strokeColor=#D97706;strokeWidth=1.5;" edge="1" parent="1" source="c_dashboard_state" target="c_sim_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- _DashboardScreenState exports ReportService -->
        <mxCell id="rel_dash_report" value="uses" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#9333EA;strokeWidth=1.5;" edge="1" parent="1" source="c_dashboard_state" target="c_report_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- _DashboardScreenState renders Cards -->
        <mxCell id="rel_dash_ldr" value="renders" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;exitX=0;exitY=0.8;entryX=1;entryY=0.5;strokeColor=#0284C7;strokeWidth=1.5;" edge="1" parent="1" source="c_dashboard_state" target="w_ldr">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="384" />
              <mxPoint x="350" y="630" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- NfcService has TheoJansenDataParser -->
        <mxCell id="rel_nfc_parser" value="- _parser" style="endArrow=diamondThin;endFill=1;endSize=14;html=1;rounded=0;exitX=1;exitY=0.3;entryX=0;entryY=0.5;strokeColor=#16A34A;strokeWidth=1.5;" edge="1" parent="1" source="c_nfc_service" target="c_parser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TheoJansenDataParser decodes RobotTelemetry -->
        <mxCell id="rel_parser_telemetry" value="decodes" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#16A34A;strokeWidth=1.5;" edge="1" parent="1" source="c_parser" target="c_telemetry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SimulationService produces RobotTelemetry -->
        <mxCell id="rel_sim_telemetry" value="produces" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;exitX=1;exitY=0.4;entryX=0;entryY=0.5;strokeColor=#16A34A;strokeWidth=1.5;" edge="1" parent="1" source="c_sim_service" target="c_telemetry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RobotTelemetry uses LightDirection -->
        <mxCell id="rel_telemetry_direction" value="uses" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;exitX=0.3;exitY=1;entryX=0.5;entryY=0;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="c_telemetry" target="e_direction">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RobotTelemetry uses MotorState -->
        <mxCell id="rel_telemetry_motor" value="uses" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;exitX=0.7;exitY=1;entryX=0.5;entryY=0;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="c_telemetry" target="e_motor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- UnsupportedProtocolVersionException extends InvalidTelemetryException -->
        <mxCell id="rel_version_invalid" value="extends" style="endArrow=block;endFill=0;html=1;rounded=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeColor=#DC2626;strokeWidth=2;" edge="1" parent="1" source="ex_version" target="ex_invalid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CorruptedPayloadException extends InvalidTelemetryException -->
        <mxCell id="rel_corrupt_invalid" value="extends" style="endArrow=block;endFill=0;html=1;rounded=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeColor=#DC2626;strokeWidth=2;" edge="1" parent="1" source="ex_corrupt" target="ex_invalid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TheoJansenDataParser throws InvalidTelemetryException -->
        <mxCell id="rel_parser_throws" value="throws" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;exitX=1;exitY=0.7;entryX=0;entryY=0.5;strokeColor=#DC2626;strokeWidth=1.5;" edge="1" parent="1" source="c_parser" target="ex_invalid">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1550" y="209" />
              <mxPoint x="1550" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- NfcService throws NfcDeviceException -->
        <mxCell id="rel_service_throws" value="throws" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;exitX=1;exitY=0.2;entryX=0;entryY=0.5;strokeColor=#DC2626;strokeWidth=1.5;" edge="1" parent="1" source="c_nfc_service" target="ex_device">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1140" y="282" />
              <mxPoint x="1140" y="60" />
              <mxPoint x="1550" y="60" />
              <mxPoint x="1550" y="145" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
