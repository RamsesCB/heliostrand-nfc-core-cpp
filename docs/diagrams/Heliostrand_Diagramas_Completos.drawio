  <diagram id="tab-06-mobile-processes" name="6. Procesos - Flutter Mobile">
    <mxGraphModel dx="2100" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1550" math="0" shadow="0">
