        <mxCell id="pf_card_yes" value="[Sí: Tag Detectado]" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#16A34A;labelBackgroundColor=#FFFFFF;fontColor=#15803D;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="p_dec_card_present" target="p_act_hw_read_apdu" parent="lane_jd_hw"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="pf_5" style="html=1;endArrow=classic;strokeWidth=2;strokeColor=#475569;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="p_act_hw_read_apdu" target="p_act_core_slots" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
