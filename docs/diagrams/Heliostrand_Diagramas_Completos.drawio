          <mxGeometry x="140" y="460" width="40" height="40" as="geometry"/>
        </mxCell>

        <!-- UI: Dashboard -->
        <mxCell id="mp_act_ui_dash" value="&lt;b&gt;Cargar DashboardScreen&lt;/b&gt;&lt;br&gt;Inicializar StreamSubscriptions de BaseTelemetryService y preparar tarjetas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#0284C7;fontColor=#0369A1;strokeWidth=2;" vertex="1" parent="lane_ma_ui">
          <mxGeometry x="120" y="245" width="320" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="mp_dec_mode" value="¿Modo Seleccionado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0369A1;fontStyle=1;strokeWidth=2;" vertex="1" parent="lane_ma_ui">
          <mxGeometry x="190" y="345" width="180" height="90" as="geometry"/>
        </mxCell>

        <!-- Simulación -->
        <mxCell id="mp_act_sim_stream" value="&lt;b&gt;SimulationService.start()&lt;/b&gt;&lt;br&gt;Emitir lecturas sintetizadas en Stream periódico cada 1500 ms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;strokeWidth=2;" vertex="1" parent="lane_ma_ui">
          <mxGeometry x="280" y="470" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- NFC Session -->
        <mxCell id="mp_act_nfc_poll" value="&lt;b&gt;NfcService.startContinuousScan()&lt;/b&gt;&lt;br&gt;Invocar &lt;code&gt;FlutterNfcKit.poll(timeout: 10s)&lt;/code&gt; solicitando ISO14443-A" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#14532D;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="140" y="470" width="320" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="mp_dec_tag_found" value="¿Tag NTAG213&lt;br&gt;Detectado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="220" y="565" width="160" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="mp_act_nfc_read_pages" value="&lt;b&gt;Lectura Transaccional de Memoria&lt;/b&gt;&lt;br&gt;Leer páginas 4 a 11 (Slot A: 4-7, Slot B: 8-11) mediante comandos FAST_READ o READ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#14532D;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="130" y="690" width="340" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="mp_act_nfc_parse" value="&lt;b&gt;TheoJansenDataParser.decodeTelemetryPayload()&lt;/b&gt;&lt;br&gt;1. Seleccionar generación más reciente (Ping-Pong)&lt;br&gt;2. Verificar CRC-8 (polinomio 0x07)&lt;br&gt;3. Deserializar LDRs, Ángulos, Batería y Motor" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#14532D;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="130" y="785" width="340" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="mp_dec_crc_valid" value="¿Trama y CRC-8&lt;br&gt;Válidos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="220" y="890" width="160" height="85" as="geometry"/>
        </mxCell>

        <!-- Command Write Phase (Móvil puede escribir!) -->
        <mxCell id="mp_dec_has_cmd" value="¿Existe comando&lt;br&gt;de servos pendiente?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0369A1;fontStyle=1;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="210" y="1005" width="180" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="mp_act_nfc_write" value="&lt;b&gt;FlutterNfcKit.transceive()&lt;/b&gt;&lt;br&gt;Escribir página de comando (Pitch/Yaw) en NTAG213 antes de desconectar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0369A1;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="130" y="1125" width="340" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="mp_act_nfc_finish" value="&lt;b&gt;FlutterNfcKit.finish()&lt;/b&gt;&lt;br&gt;Cerrar canal RF y liberar el transceptor NFC del smartphone" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#14532D;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="160" y="1220" width="280" height="50" as="geometry"/>
        </mxCell>

        <!-- UI: Reactividad & Renderizado -->
        <mxCell id="mp_act_ui_stream" value="&lt;b&gt;StreamController.add(RobotTelemetry)&lt;/b&gt;&lt;br&gt;Emitir modelo hacia el Stream reactivo de la UI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#0284C7;fontColor=#0369A1;strokeWidth=2;" vertex="1" parent="lane_ma_ui">
          <mxGeometry x="140" y="1020" width="280" height="60" as="geometry"/>
        </mxCell>

