        <!-- Titulo -->
        <mxCell id="ma_proc_title" value="&lt;b&gt;&lt;font size=&quot;4&quot;&gt;HELiOSTRAND - DIAGRAMA DE ACTIVIDADES Y PROCESOS (FLUTTER MOBILE APP)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Proceso: VersionGate, Sesión Transaccional NFC (Lectura Ping-Pong y Escritura de Servos) y Renderizado Reactivo con Streams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#F8FAFC;align=center;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1680" height="58" as="geometry"/>
        </mxCell>

        <!-- Swimlanes -->
        <mxCell id="lane_ma_gate" value="&lt;b&gt;Servicios de Políticas &amp;amp; Gateways (UpdatePolicyService &amp;amp; VersionGate)&lt;/b&gt;" style="swimlane;startSize=40;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontStyle=1;fontSize=13;swimlaneLine=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="520" height="1360" as="geometry"/>
        </mxCell>

        <mxCell id="lane_ma_nfc" value="&lt;b&gt;Transporte &amp;amp; Dominio (BaseTelemetryService, NfcService &amp;amp; TheoJansenDataParser)&lt;/b&gt;" style="swimlane;startSize=40;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;fontSize=13;swimlaneLine=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="600" height="1360" as="geometry"/>
        </mxCell>

        <mxCell id="lane_ma_ui" value="&lt;b&gt;Capa UI Reactiva (DashboardScreen &amp;amp; Widgets de Tarjetas)&lt;/b&gt;" style="swimlane;startSize=40;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0369A1;fontStyle=1;fontSize=13;swimlaneLine=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1160" y="100" width="560" height="1360" as="geometry"/>
        </mxCell>

        <!-- Nodos de Inicio -->
        <mxCell id="mp_node_start" value="" style="ellipse;fillColor=#1E293B;strokeColor=#0F172A;" vertex="1" parent="lane_ma_gate">
          <mxGeometry x="240" y="60" width="40" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="mp_act_gate_check" value="&lt;b&gt;VersionGate.initState()&lt;/b&gt;&lt;br&gt;Consultar UpdatePolicyService.requiresUpdate(currentVersion)&lt;br&gt;Comprobar compatibilidad mínima con protocolo V2 (2.0.0)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#D97706;fontColor=#78350F;strokeWidth=2;" vertex="1" parent="lane_ma_gate">
          <mxGeometry x="90" y="130" width="340" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="mp_dec_update_req" value="¿Requiere&lt;br&gt;actualización?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontStyle=1;strokeWidth=2;" vertex="1" parent="lane_ma_gate">
          <mxGeometry x="180" y="230" width="160" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="mp_act_gate_lock" value="&lt;b&gt;Bloquear Interfaz Móvil&lt;/b&gt;&lt;br&gt;Renderizar pantalla de alerta obligatoria con enlace directo a tienda o APK corporativo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;strokeWidth=2;" vertex="1" parent="lane_ma_gate">
          <mxGeometry x="20" y="360" width="280" height="65" as="geometry"/>
        </mxCell>

