        <mxCell id="mp_act_nfc_read_pages" value="&lt;b&gt;Lectura Transaccional de Memoria&lt;/b&gt;&lt;br&gt;Leer páginas 4 a 11 (Slot A: 4-7, Slot B: 8-11) mediante comandos FAST_READ o READ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#14532D;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
          <mxGeometry x="130" y="690" width="340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="mp_act_nfc_parse" value="&lt;b&gt;TheoJansenDataParser.decodeTelemetryPayload()&lt;/b&gt;&lt;br&gt;1. Seleccionar generación más reciente (Ping-Pong)&lt;br&gt;2. Verificar CRC-8 (polinomio 0x07)&lt;br&gt;3. Deserializar LDRs, Ángulos, Batería y Motor" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#14532D;strokeWidth=2;" vertex="1" parent="lane_ma_nfc">
