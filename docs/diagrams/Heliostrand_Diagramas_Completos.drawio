          <mxGeometry x="40" y="100" width="480" height="1280" as="geometry" />
        </mxCell>
        <mxCell id="lane_jd_core" value="Núcleo y Parser (AbstractNfcService &amp; TheoJansenDataParser)" style="fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;fontSize=12;swimlaneLine=1;strokeWidth=2;align=left;verticalAlign=top;spacing=10;rounded=0;" vertex="1" parent="1">
